+static void imac_cs42l83_configure_serial_port(struct hda_codec *codec)
+{
+	struct sub_codec cs42l83;
+	int ret;
+
+	codec_info(codec, "iMac cs42l83 configure serial port start\n");
+
+	memset(&cs42l83, 0, sizeof(cs42l83));
+
+	cs42l83.codec = codec;
