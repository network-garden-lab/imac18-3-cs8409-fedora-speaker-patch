+static void imac_tas576_tdm_slot_setup(struct hda_codec *codec)
+{
+	struct sub_codec amp;
+	static const unsigned int addrs[4] = { 0xd8, 0xda, 0xdc, 0xde };
+	static const unsigned int chans[4] = { 0x00, 0x02, 0x01, 0x03 };
+	static const unsigned int vols[4] = { 0x00cf, 0x00cf, 0x00cf, 0x00cf };
+	/* TAS576 slot mapping: 0xfc = muted, 0xfd = enabled */
+	static const unsigned int pwr[4]  = { 0x00fd, 0x00fd, 0x00fd, 0x00fd };
+	int i, ret;
+
+	codec_info(codec, "iMac TAS576 TDM slot setup start\n");
+
+	for (i = 0; i < 4; i++) {
+		memset(&amp, 0, sizeof(amp));
+
+		amp.codec = codec;
+		amp.addr = addrs[i];
+		amp.paged = 0;
+		amp.last_page = 0;
+		amp.suspended = 0;
+
+		ret = cs8409_i2c_write(&amp, 0x0002, 0x0044);
+		codec_dbg(codec, "TAS576 0x%x WRITE 0x0002 value=0x0044 ret=0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_write(&amp, 0x0003, 0x0080 | chans[i]);
+		codec_dbg(codec, "TAS576 0x%x WRITE 0x0003 value=0x%04x ret=0x%x\n",
+			   addrs[i], 0x0080 | chans[i], ret);
+
+		ret = cs8409_i2c_write(&amp, 0x0006, 0x0055);
+		codec_dbg(codec, "TAS576 0x%x WRITE 0x0006 value=0x0055 ret=0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_write(&amp, 0x0008, 0x0018);
+		codec_dbg(codec, "TAS576 0x%x WRITE 0x0008 value=0x0018 ret=0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_write(&amp, 0x0004, vols[i]);
+		codec_dbg(codec, "TAS576 0x%x WRITE 0x0004 value=0x%04x ret=0x%x\n",
+			   addrs[i], vols[i], ret);
+
+		ret = cs8409_i2c_write(&amp, 0x0013, 0x0000);
+		codec_dbg(codec, "TAS576 0x%x WRITE 0x0013 value=0x0000 ret=0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_write(&amp, 0x0002, 0x0044);
+		codec_dbg(codec, "TAS576 0x%x WRITE 0x0002 again value=0x0044 ret=0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_write(&amp, 0x0001, pwr[i]);
+		codec_dbg(codec, "TAS576 0x%x WRITE 0x0001 value=0x%04x ret=0x%x\n",
+			   addrs[i], pwr[i], ret);
+
+		ret = cs8409_i2c_read(&amp, 0x0001);
+		codec_dbg(codec, "TAS576 0x%x READ BACK 0x0001 POWER = 0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_read(&amp, 0x0002);
+		codec_dbg(codec, "TAS576 0x%x READ BACK 0x0002 MODE = 0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_read(&amp, 0x0003);
+		codec_dbg(codec, "TAS576 0x%x READ BACK 0x0003 SLOT = 0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_read(&amp, 0x0004);
+		codec_dbg(codec, "TAS576 0x%x READ BACK 0x0004 VOL = 0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_read(&amp, 0x0006);
+		codec_dbg(codec, "TAS576 0x%x READ BACK 0x0006 ANALOG = 0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_read(&amp, 0x0008);
+		codec_dbg(codec, "TAS576 0x%x READ BACK 0x0008 FAULT = 0x%x\n", addrs[i], ret);
+	}
+
+	codec_info(codec, "iMac TAS576 TDM slot setup end\n");
+}
