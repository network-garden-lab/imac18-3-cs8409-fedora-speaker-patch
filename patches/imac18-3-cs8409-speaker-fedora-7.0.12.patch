+static void imac_tas576_boot_reset_setup(struct hda_codec *codec)
+{
+	struct sub_codec amp;
+	static const unsigned int addrs[4] = { 0xd8, 0xda, 0xdc, 0xde };
+	int i, ret;
+
+	codec_info(codec, "iMac TAS576 boot reset setup start\n");
+
+	for (i = 0; i < 4; i++) {
+		memset(&amp, 0, sizeof(amp));
+
+		amp.codec = codec;
+		amp.addr = addrs[i];
+		amp.paged = 0;
+		amp.last_page = 0;
+		amp.suspended = 0;
+
+		ret = cs8409_i2c_write(&amp, 0x0001, 0x00fc);
+		codec_dbg(codec, "TAS576 0x%x BOOT WRITE 0x0001 value=0x00fc ret=0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_write(&amp, 0x0002, 0x0004);
+		codec_dbg(codec, "TAS576 0x%x BOOT WRITE 0x0002 value=0x0004 ret=0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_write(&amp, 0x0003, 0x0080);
+		codec_dbg(codec, "TAS576 0x%x BOOT WRITE 0x0003 value=0x0080 ret=0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_write(&amp, 0x0004, 0x00cf);
+		codec_dbg(codec, "TAS576 0x%x BOOT WRITE 0x0004 value=0x00cf ret=0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_write(&amp, 0x0006, 0x0051);
+		codec_dbg(codec, "TAS576 0x%x BOOT WRITE 0x0006 value=0x0051 ret=0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_write(&amp, 0x0008, 0x0000);
+		codec_dbg(codec, "TAS576 0x%x BOOT WRITE 0x0008 value=0x0000 ret=0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_write(&amp, 0x0013, 0x0000);
+		codec_dbg(codec, "TAS576 0x%x BOOT WRITE 0x0013 value=0x0000 ret=0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_write(&amp, 0x0014, 0x0002);
+		codec_dbg(codec, "TAS576 0x%x BOOT WRITE 0x0014 value=0x0002 ret=0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_read(&amp, 0x0008);
+		codec_dbg(codec, "TAS576 0x%x BOOT READ BACK 0x0008 = 0x%x\n", addrs[i], ret);
+
+		ret = cs8409_i2c_read(&amp, 0x0014);
+		codec_dbg(codec, "TAS576 0x%x BOOT READ BACK 0x0014 = 0x%x\n", addrs[i], ret);
+	}
+
+	codec_info(codec, "iMac TAS576 boot reset setup end\n");
+}
